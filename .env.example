# Copy to .env.local and fill in. Never commit real keys.

# --- Supabase (Project settings > API) ---
# Safe for the browser: protected by row level security (see supabase/migrations).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row level security: use in route handlers and jobs, never in client code.
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude API (console.anthropic.com) ---
# Server only. Without it, /api/extract and /api/letters answer 503 and the app falls back to demo data.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5-5.
ANTHROPIC_MODEL=
# Optional. Set to "off" to disable the server-side model fallback (on by default).
ANTHROPIC_SERVER_FALLBACK=
